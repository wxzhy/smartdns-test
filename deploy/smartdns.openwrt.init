#!/bin/sh /etc/rc.common

# OpenWrt procd service. Keep these paths in sync with docs/openwrt-installation.md.
START=95
STOP=10
USE_PROCD=1

APP_DIR=/opt/smartdns-python
PYTHON="$APP_DIR/.venv/bin/python"
CONFIG="$APP_DIR/config.yaml"
CAPABILITIES="$APP_DIR/deploy/smartdns.openwrt.capabilities.json"
RUN_DIR=/var/run/smartdns-python
RUN_USER=smartdnspy
SERVICE_NAME=smartdns-python

service_stopped() {
    # rc.common/procd_kill only submits an asynchronous delete request. Wait
    # until the instance exits so `stop` does not report success while it is
    # still serving DNS. ujail may take its 35-second grace period, and procd
    # allows additional time for the jail supervisor.
    local remaining=75
    while procd_running "$SERVICE_NAME" main; do
        if [ "$remaining" -eq 0 ]; then
            echo "smartdns: stop timed out; instance is still running" >&2
            return 1
        fi
        sleep 1
        remaining=$((remaining - 1))
    done
}

root_owned_regular_file() {
    # OpenWrt may provide BusyBox ls without a stat applet or coreutils-stat.
    local details expected
    expected=$2
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    details=$(LC_ALL=C ls -ldn "$1" 2>/dev/null) || return 1
    set -- $details
    [ "$#" -ge 4 ] && [ "$1" = "$expected" ] && \
        [ "$3" = 0 ] && [ "$4" = 0 ]
}

start_service() {
    if [ ! -f "$APP_DIR/pyproject.toml" ]; then
        echo "smartdns: project files are missing from $APP_DIR; copy the ZIP's top-level directory contents here" >&2
        return 1
    fi
    if [ ! -x "$PYTHON" ]; then
        echo "smartdns: Python is missing or not executable: $PYTHON; install Python inside $APP_DIR and run uv sync" >&2
        return 1
    fi
    if [ ! -r "$CONFIG" ]; then
        echo "smartdns: config is missing or unreadable: $CONFIG" >&2
        return 1
    fi
    if ! root_owned_regular_file "$CAPABILITIES" '-rw-r--r--'; then
        echo "smartdns: capability profile must be a regular root:root 0644 file: $CAPABILITIES (check with ls -ldn)" >&2
        return 1
    fi
    if ! id -u "$RUN_USER" >/dev/null 2>&1; then
        echo "smartdns: service user is missing: $RUN_USER" >&2
        return 1
    fi
    if [ ! -x /sbin/ujail ]; then
        echo "smartdns: procd-ujail is required for the OpenWrt service" >&2
        return 1
    fi
    local python_real path
    python_real=$(readlink -f "$PYTHON") || {
        echo "smartdns: cannot resolve Python interpreter: $PYTHON" >&2
        return 1
    }
    if [ ! -x "$python_real" ]; then
        echo "smartdns: resolved Python interpreter is not executable: $python_real" >&2
        return 1
    fi
    case "$python_real" in
        *[[:space:]]*)
            echo "smartdns: Python path cannot contain whitespace" >&2
            return 1
            ;;
        "$APP_DIR"/*) ;;
        *)
            echo "smartdns: Python interpreter must reside inside $APP_DIR for the jail: $python_real; see docs/openwrt-installation.md" >&2
            return 1
            ;;
    esac

    # /var/run is root-managed on OpenWrt; reject a substituted leaf symlink.
    if [ -L "$RUN_DIR" ] || { [ -e "$RUN_DIR" ] && [ ! -d "$RUN_DIR" ]; }; then
        echo "smartdns: invalid runtime directory" >&2
        return 1
    fi
    umask 077
    mkdir -p -m 0700 "$RUN_DIR" && \
        chown "$RUN_USER:$RUN_USER" "$RUN_DIR" && \
        chmod 0700 "$RUN_DIR" || return 1

    procd_open_instance main
    # Resolve relative paths from APP_DIR and apply the systemd unit's UMask=0027.
    procd_set_param command /bin/sh -c \
        'cd "$1" && umask 027 && exec "$2" -m smartdns.main --config "$3"' \
        smartdns "$APP_DIR" "$PYTHON" "$CONFIG"
    procd_set_param user "$RUN_USER"
    procd_set_param group "$RUN_USER"
    procd_set_param no_new_privs 1
    # Keep the profile's capability sets in sync with smartdns.service.
    procd_set_param capabilities "$CAPABILITIES"
    procd_set_param env "HOME=$RUN_DIR" "TMPDIR=$RUN_DIR" \
        PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
    procd_add_jail smartdns-python ronly log requirejail
    # Stage the Python installation via APP_DIR; staging its ELF binary alone
    # can crash ujail on some OpenWrt-derived builds.
    procd_add_jail_mount "$APP_DIR"
    for path in /lib /usr/lib /usr/local/lib /usr/share/ca-certificates \
        /etc/ssl /etc/hosts /etc/resolv.conf /etc/nsswitch.conf \
        /etc/TZ /etc/localtime /etc/passwd /etc/group; do
        [ -e "$path" ] && procd_add_jail_mount "$path"
    done
    procd_add_jail_mount_rw "$RUN_DIR"
    # Give the jailed process the same 35-second stop grace as TimeoutStopSec.
    procd_set_param term_timeout 35
    procd_set_param respawn 3600 5 5
    procd_set_param file "$CONFIG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
