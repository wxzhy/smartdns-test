[Unit]
Description=SmartDNS DNS proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=smartdns
DynamicUser=yes
WorkingDirectory=/opt/smartdns
Environment=HOME=/var/lib/smartdns
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/opt/smartdns/environment
LoadCredential=config.yaml:/opt/smartdns/config.yaml
ExecStart=/opt/smartdns/.venv/bin/python -m smartdns.main --config ${CREDENTIALS_DIRECTORY}/config.yaml
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=35
StateDirectory=smartdns
UMask=0027
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectProc=invisible
NoNewPrivileges=true
ProtectClock=true
SystemCallArchitectures=native
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET
MemoryDenyWriteExecute=true
ProtectHostname=true
[Install]
WantedBy=multi-user.target
